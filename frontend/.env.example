# Firebase Web app config from Project settings > Your apps.
# Do not put Firebase Admin service-account credentials or private keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend API base URL. Use /api with the Vite dev proxy, or an absolute URL
# (e.g. http://localhost:5000/api) when the API is hosted separately.
VITE_API_URL=/api

# URL Firebase redirects to after an email-link sign-in.
# The host must be added to Firebase Authentication > Settings > Authorized domains.
VITE_EMAIL_LINK_URL=http://localhost:5173/
