APP_NAME="Digital Attendance Laravel Frontend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

SESSION_DRIVER=file
SESSION_LIFETIME=120

# Node backend maintained by the teammate. The Laravel app only consumes it.
API_BASE_URL=http://localhost:5000
ATTENDANCE_HISTORY_PATH=/api/v1/attendance/history
REPORTS_EXPORT_PATH=/api/reports/export
