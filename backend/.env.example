PORT=5000
FRONTEND_URL=http://localhost:5173,http://localhost:4173

# Firebase Admin (used to verify ID tokens on protected API routes).
# Get these from Firebase console > Project settings > Service accounts.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# Google service-account values for the attendance spreadsheet.
# Share the spreadsheet with GOOGLE_CLIENT_EMAIL.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=""
SPREADSHEET_ID=
USERS_SHEET_RANGE=Users!A:Z
