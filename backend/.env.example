# Copy to backend/.env and replace the placeholders with real values.
# Never commit the populated .env file or any private keys.

# Server
PORT=5000
FRONTEND_URL=http://localhost:3000

# Firebase Admin SDK (service account)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-firebase-project-id.iam.gserviceaccount.com
# Use literal \n between PEM lines on a single line, or a real multi-line value.
FIREBASE_PRIVATE_KEY=replace-with-service-account-private-key

# Google Sheets API (service account)
GOOGLE_CLIENT_EMAIL=your-sheets-service-account@your-project.iam.gserviceaccount.com
# Use literal \n between PEM lines on a single line, or a real multi-line value.
GOOGLE_PRIVATE_KEY=replace-with-sheets-private-key
SPREADSHEET_ID=replace-with-attendance-spreadsheet-id
# Optional: defaults to columns A:Z of the first sheet tab.
SHEET_RANGE=
