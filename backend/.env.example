PORT=5000
FRONTEND_URL=http://localhost:5173

# Firebase Admin SDK
# Source: Firebase console > Project settings > Service accounts > Generate new private key
# Copy the values only, not the JSON syntax:
#   - FIREBASE_PROJECT_ID and FIREBASE_CLIENT_EMAIL: no quotes, no trailing comma, no spaces
#   - FIREBASE_PRIVATE_KEY: one line, in double quotes, with \n left as typed text
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_YOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"